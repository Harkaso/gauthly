# Copy this file to `.env` and replace the placeholder values with your own.
# `.env` holds real secrets and is gitignored — never commit it.

# ─── PostgreSQL ────────────────────────────────────────────────────────────────────────────────────────────
# Dedicated least-privilege database role for the API.
# Never use the postgres superuser.
POSTGRES_USER=gauthly_app

# Database password. Generate a strong random value: `openssl rand -hex 32`.
# Use hex, not base64, to avoid the / and + characters that break the URL below.
POSTGRES_PASSWORD="your-database-secret-password-here"

# Name of the database owned by POSTGRES_USER.
POSTGRES_DB=gauthly_db

# Connection string used by the API. The "db" host is the Postgres service name
# on the Docker Compose network.
DB_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}?sslmode=disable

# ─── Goose (database migrations) ───────────────────────────────────────────────────────────────────────────
# Database driver used by the goose CLI.
GOOSE_DRIVER=postgres

# Database goose connects to (same as the API).
GOOSE_DBSTRING=${DB_URL}

# Folder containing the migration files.
GOOSE_MIGRATION_DIR=./migrations

# ─── Seed ──────────────────────────────────────────────────────────────────────────────────────────────────
# UUID of the default B2C tenant, used as the fallback when no tenant is resolved.
# Must stay identical to the UUID seeded in migrations/00004_seed_default_tenant.sql.
DEFAULT_TENANT_ID=00000000-0000-4000-8000-000000000000

# ─── Tenancy ───────────────────────────────────────────────────────────────────────────────────────────────
# Tenant resolution mode. "b2b": every request must carry an X-Tenant-ID header.
# "b2c": X-Tenant-ID is rejected and DEFAULT_TENANT_ID is used for every request.
# Case-insensitive. Defaults to b2b.
TENANT_MODE=b2b

# ─── Network ───────────────────────────────────────────────────────────────────────────────────────────────
# Address the HTTP server listens on. Format ":port" (host part optional).
PORT=:8080

# ─── Logging ───────────────────────────────────────────────────────────────────────────────────────────────
# Log output format. "text": human-readable, for development. "json": structured,
# for production log aggregation. Defaults to text.
LOG_FORMAT=text
