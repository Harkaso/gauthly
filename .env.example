# Copy this file to `.env` and replace the placeholder values with your own.
# `.env` holds real secrets and is gitignored — never commit it.

# ─── PostgreSQL ──────────────────────────────────────────────────────────────────────────────────
# Application database role. A least-privilege account dedicated to the API;
# do not reuse the "postgres" superuser.
POSTGRES_USER=gauthly_app

# Database password. Generate a strong random value, e.g. `openssl rand -hex 32`.
# Prefer hex over base64: it avoids the "/" and "+" characters that would break
# the DB_URL connection string below.
POSTGRES_PASSWORD="your-database-secret-password-here"

# Name of the database owned by POSTGRES_USER.
POSTGRES_DB=gauthly_db

# Connection string read by the API
# - Use "db" host when the API runs inside the Compose network
# - Use "localhost" when you run `go run ./cmd/api` directly on your host.
DB_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}?sslmode=disable
